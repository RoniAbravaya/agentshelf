# ---------------------------------------------------------------------------
# AgentShelf environment. Copy to .env and fill in what you have.
# Everything is optional for a local demo: with no DATABASE_URL the app uses an
# embedded Postgres (PGlite) under ./.data, and with no AI keys the listing
# generator falls back to a deterministic stub so the UI still works.
# ---------------------------------------------------------------------------

# App URLs
APP_URL=http://localhost:3000
MCP_URL=http://localhost:3001
MCP_PORT=3001

# Session signing secret (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Database. Leave empty to use embedded PGlite at ./.data/agentshelf
# Supabase: Project Settings > Database > Connection string (URI, "Transaction" pooler is fine)
DATABASE_URL=

# PayPal SANDBOX REST app (Developer Dashboard > Apps & Credentials > Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the Developer Dashboard (needed for signature verification)
PAYPAL_WEBHOOK_ID=
# Public client id for the JS SDK buttons (same as PAYPAL_CLIENT_ID)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# AI providers for listing generation / mandate parsing.
# LISTING_AI_PROVIDER: anthropic | openai | stub (default: first provider with a key, else stub)
LISTING_AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=

# Embeddings (optional). EMBEDDINGS_PROVIDER: openai | voyage | none
EMBEDDINGS_PROVIDER=none
VOYAGE_API_KEY=
EMBEDDINGS_MODEL=

# Photo storage: local (default, apps/web/public/uploads) | supabase
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=listing-photos

# Encryption key for private fields (pickup address, phone, vault token). 32 bytes base64.
DATA_ENCRYPTION_KEY=

# Internal shared secret between the web app and the MCP server (server-to-server)
INTERNAL_API_SECRET=change-me-too

# Agent orders: who is the PayPal payee for purchases made through MCP?
#   seller   -> purchase_units[0].payee = the seller's PayPal email (default; verify vault_id + payee works in your sandbox)
#   platform -> no payee set; the platform account receives funds (fallback if PayPal rejects vault_id + different payee)
PAYPAL_AGENT_PAYEE_MODE=seller
